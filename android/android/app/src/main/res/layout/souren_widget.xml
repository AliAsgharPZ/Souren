<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="14dp"
    android:background="@drawable/souren_widget_background"
    android:layoutDirection="rtl">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="سورن"
        android:textColor="@color/widget_title"
        android:textSize="13sp"
        android:fontFamily="sans"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="start" />

    <TextView
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:text="اطلاعات آموزشی"
        android:textColor="@color/widget_text"
        android:textSize="20sp"
        android:fontFamily="sans"
        android:textStyle="bold"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="start" />

    <TextView
        android:id="@+id/widget_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:textColor="@color/widget_muted"
        android:textSize="11sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:gravity="start" />

    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="9dp"
        android:progress="0"
        android:max="100"
        android:progressTint="@color/widget_accent"
        android:progressBackgroundTint="@color/widget_track" />

    <TextView
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widget_accent"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:gravity="start" />
</LinearLayout>
